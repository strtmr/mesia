{% extends 'app/layout.html.twig' %}

{% block page_title %}{{ 'more.title'|trans }}{% endblock %}

{% block content %}
    {% set user = app.user %}

    <section class="list-section">
        <h2 class="list-section__title">{{ 'more.account.section'|trans }}</h2>
        <dl class="list-group">
            <div class="list-group__row">
                <dt>{{ 'more.account.name'|trans }}</dt>
                <dd>{{ user.displayName }}</dd>
            </div>
            <div class="list-group__row">
                <dt>{{ 'more.account.email'|trans }}</dt>
                <dd>{{ user.email }}</dd>
            </div>
            <div class="list-group__row">
                <dt>{{ 'more.account.household'|trans }}</dt>
                <dd>{{ user.household.name }}</dd>
            </div>
        </dl>
    </section>

    <section class="list-section">
        <h2 class="list-section__title">{{ 'more.shopping.section'|trans }}</h2>
        <div class="list-group">
            <a class="list-group__row list-group__row--link" href="{{ path('catalog_categories') }}">
                <span>{{ 'more.shopping.categories'|trans }}</span>
                <span class="list-group__value">{{ 'more.shopping.categories_hint'|trans }}</span>
            </a>
        </div>
    </section>

    <section class="list-section">
        <h2 class="list-section__title">{{ 'more.app.section'|trans }}</h2>
        <div class="list-group">
            <a class="list-group__row list-group__row--link" href="{{ path('app_release_notes') }}">
                <span>{{ 'more.app.version'|trans }}</span>
                <span class="list-group__value">{{ app_version }} · {{ 'more.app.release_notes'|trans }}</span>
            </a>
            <div class="list-group__row" data-controller="connection-status"
                 data-connection-status-online-value="{{ 'more.app.online'|trans }}"
                 data-connection-status-offline-value="{{ 'more.app.offline'|trans }}">
                <span>{{ 'more.app.connection'|trans }}</span>
                <span class="list-group__value" data-connection-status-target="label">{{ 'more.app.online'|trans }}</span>
            </div>
        </div>
    </section>

    <section class="list-section">
        <div class="list-group">
            <a class="list-group__row list-group__row--action list-group__row--danger" href="{{ path('app_logout') }}" data-turbo="false"
               data-controller="logout" data-action="logout#logout">
                {{ 'more.logout'|trans }}
            </a>
        </div>
    </section>
{% endblock %}
