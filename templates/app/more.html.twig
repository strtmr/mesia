{% extends 'app/layout.html.twig' %}

{% block page_title %}{{ 'more.title'|trans }}{% endblock %}

{% block content %}
    {% set user = app.user %}

    <section class="list-section">
        <h2 class="list-section__title">{{ 'more.account.section'|trans }}</h2>
        <dl class="list-group">
            <div class="list-group__row">
                <dt>{{ 'more.account.name'|trans }}</dt>
                <dd>{{ user.displayName }}</dd>
            </div>
            <div class="list-group__row">
                <dt>{{ 'more.account.email'|trans }}</dt>
                <dd>{{ user.email }}</dd>
            </div>
            <div class="list-group__row">
                <dt>{{ 'more.account.household'|trans }}</dt>
                <dd>{{ user.household.name }}</dd>
            </div>
        </dl>
    </section>

    <section class="list-section">
        <h2 class="list-section__title">{{ 'more.shopping.section'|trans }}</h2>
        <div class="list-group">
            <a class="list-group__row list-group__row--link" href="{{ path('catalog_categories') }}">
                <span>{{ 'more.shopping.categories'|trans }}</span>
                <span class="list-group__value">{{ 'more.shopping.categories_hint'|trans }}</span>
            </a>
            <a class="list-group__row list-group__row--link" href="{{ path('shopping_stores') }}">
                <span>{{ 'more.shopping.stores'|trans }}</span>
                <span class="list-group__value">{{ 'more.shopping.stores_hint'|trans }}</span>
            </a>
        </div>
    </section>

    {# Mitteilungen dieses Geräts (controllers/push_settings_controller.js) #}
    <section class="list-section" data-controller="push-settings"
             data-push-settings-status-url-value="{{ path('api_push_status') }}"
             data-push-settings-subscription-url-value="{{ path('api_push_subscribe') }}"
             data-push-settings-text-unsupported-value="{{ 'push.settings.unsupported'|trans }}"
             data-push-settings-text-not-configured-value="{{ 'push.settings.not_configured'|trans }}"
             data-push-settings-text-denied-value="{{ 'push.settings.denied'|trans }}"
             data-push-settings-text-error-value="{{ 'push.settings.error'|trans }}">
        <h2 class="list-section__title">{{ 'push.settings.section'|trans }}</h2>
        <div class="list-group">
            <label class="list-group__row">
                <span class="list-group__label">
                    {{ 'push.settings.enabled'|trans }}
                    <small>{{ 'push.settings.enabled_hint'|trans }}</small>
                </span>
                <input type="checkbox" class="switch" data-push-settings-target="toggle" data-action="push-settings#toggle" disabled>
            </label>
            <label class="list-group__row" data-push-settings-target="frequencyRow" hidden>
                <span>{{ 'push.settings.frequency'|trans }}</span>
                <select class="list-group__select" data-push-settings-target="frequency" data-action="push-settings#changeFrequency">
                    <option value="immediate">{{ 'push.settings.immediate'|trans }}</option>
                    <option value="quarter_hour">{{ 'push.settings.quarter_hour'|trans }}</option>
                </select>
            </label>
        </div>
        <p class="list-section__hint" data-push-settings-target="hint" hidden></p>
    </section>

    {% if is_granted('ROLE_ADMIN') %}
        <section class="list-section">
            <div class="list-group">
                <a class="list-group__row list-group__row--link" href="{{ path('admin') }}">
                    <span>{{ 'admin.link'|trans }}</span>
                    <span class="list-group__value">{{ 'admin.link_hint'|trans }}</span>
                </a>
            </div>
        </section>
    {% endif %}

    <section class="list-section">
        <h2 class="list-section__title">{{ 'more.app.section'|trans }}</h2>
        <div class="list-group">
            <a class="list-group__row list-group__row--link" href="{{ path('app_help') }}">
                <span>{{ 'more.app.help'|trans }}</span>
            </a>
            <a class="list-group__row list-group__row--link" href="{{ path('app_release_notes') }}">
                <span>{{ 'more.app.version'|trans }}</span>
                <span class="list-group__value">{{ app_version }} · {{ 'more.app.release_notes'|trans }}</span>
            </a>
            <div class="list-group__row" data-controller="connection-status"
                 data-connection-status-online-value="{{ 'more.app.online'|trans }}"
                 data-connection-status-offline-value="{{ 'more.app.offline'|trans }}">
                <span>{{ 'more.app.connection'|trans }}</span>
                <span class="list-group__value" data-connection-status-target="label">{{ 'more.app.online'|trans }}</span>
            </div>
        </div>
    </section>

    <section class="list-section">
        <div class="list-group">
            <a class="list-group__row list-group__row--action list-group__row--danger" href="{{ path('app_logout') }}" data-turbo="false"
               data-controller="logout" data-action="logout#logout">
                {{ 'more.logout'|trans }}
            </a>
        </div>
    </section>

    <p class="made-with">Made with <span class="made-with__heart" aria-label="Liebe">♥</span> and AI by strtmr</p>
{% endblock %}
