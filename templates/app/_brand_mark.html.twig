{#
    Mesuna Bildmarke: M als Tisch, darauf eine Schüssel (Brand Book Kapitel 3). Flach, alle Linien gleich stark.
    Tischplatte und M sind Linien (stroke), Farben per CSS: .brand-mark__table (Akzentfarbe, dunkel Creme),
    .brand-mark__bowl (Signal-Orange). Dieselben Formen stehen in public/icons/*.svg und scripts/render-splash.mjs.
#}
<svg class="brand-mark{{ class is defined ? ' ' ~ class : '' }}" viewBox="0 0 370 290" aria-hidden="true" focusable="false">
    <path class="brand-mark__bowl" d="M82 2 H288 A103 65 0 0 1 82 2 Z"/>
    <g class="brand-mark__table" fill="none" stroke-width="16" stroke-linecap="round" stroke-linejoin="round">
        <line x1="10" y1="92.5" x2="360" y2="92.5"/>
        <polyline points="45,279 45,129 185,227 325,129 325,279"/>
    </g>
</svg>
