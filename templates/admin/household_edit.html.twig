{% extends 'app/layout.html.twig' %}

{# Haushalt umbenennen, Personen bearbeiten (AdminController::editHousehold) #}

{% block page_title %}{{ 'admin.household_edit.title'|trans }}{% endblock %}
{% block header_actions %}{{ include('admin/_nav.html.twig') }}{% endblock %}

{% block content %}
    {% for message in app.flashes('success') %}
        <p class="notice notice--success" role="status">{{ message }}</p>
    {% endfor %}

    {{ form_start(form, {attr: {class: 'form-group', novalidate: 'novalidate'}}) }}
        <label class="field">
            <span class="field__label">{{ 'admin.household.name'|trans }}</span>
            {{ form_widget(form.name) }}
            {% for error in form.name.vars.errors %}
                <span class="form-error">{{ error.message }}</span>
            {% endfor %}
        </label>
        <button type="submit" class="button button--primary button--block">{{ 'admin.save'|trans }}</button>
    {{ form_end(form) }}

    <section class="list-section">
        <h2 class="list-section__title">{{ 'admin.household_edit.members'|trans }}</h2>
        <div class="list-group">
            {% for member in members %}
                <a class="list-group__row list-group__row--link" href="{{ path('admin_person_edit', {id: member.id}) }}">
                    <span>{{ member.displayName }}</span>
                    <span class="list-group__value">{{ member.email }}</span>
                </a>
            {% endfor %}
            <a class="list-group__row list-group__row--action" href="{{ path('admin_member_new', {id: household.id}) }}">{{ 'admin.person.title'|trans }}</a>
        </div>
    </section>
{% endblock %}
