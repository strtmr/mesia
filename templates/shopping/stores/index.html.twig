{% extends 'app/layout.html.twig' %}

{# „Mehr → Läden“ (StoreController::index) #}

{% block page_title %}{{ 'stores.title'|trans }}{% endblock %}

{% block header_actions %}
    <a class="header-link" href="{{ path('app_more') }}">‹ {{ 'more.title'|trans }}</a>
{% endblock %}

{% block content %}
    <p class="page-hint">{{ 'stores.hint'|trans }}</p>

    <section class="list-section">
        <div class="list-group">
            {% for store in stores %}
                <a class="list-group__row list-group__row--link" href="{{ path('shopping_stores_edit', {id: store.id}) }}">{{ store.name }}</a>
            {% else %}
                <p class="list-group__row">{{ 'stores.empty'|trans }}</p>
            {% endfor %}
        </div>
    </section>

    <a class="button button--primary button--block" href="{{ path('shopping_stores_new') }}">{{ 'stores.new'|trans }}</a>
{% endblock %}
