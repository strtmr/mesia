{% extends 'app/layout.html.twig' %}

{#
    Offline-Einkaufsliste. Die Seite ist eine benutzerunabhängige Hülle: Alle Daten kommen aus IndexedDB
    (assets/shopping), gerendert mit Alpine.js. So kann sie später vom Service Worker vorab gecacht werden.
#}

{% block head_meta %}
    {# Turbo soll keinen Schnappschuss der Alpine-Ausgabe wiederverwenden #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block body_class %}page-shopping{% endblock %}
{% block page_title %}{{ 'shopping.title'|trans }}{% endblock %}

{% block header_actions %}
    <span class="sync-status" x-data :data-state="$store.sync.state" role="status" aria-live="polite">
        <span x-cloak x-show="['synced', 'idle'].includes($store.sync.state)">{{ 'shopping.status.synced'|trans }}</span>
        <span x-cloak x-show="$store.sync.state === 'syncing'">{{ 'shopping.status.syncing'|trans }}</span>
        <span x-cloak x-show="$store.sync.state === 'pending'"><span x-text="$store.sync.pending"></span> {{ 'shopping.status.pending'|trans }}</span>
        <span x-cloak x-show="$store.sync.state === 'offline'">{{ 'shopping.status.offline'|trans }}<template x-if="$store.sync.pending > 0"><span> · <span x-text="$store.sync.pending"></span> {{ 'shopping.status.pending'|trans }}</span></template></span>
        <span x-cloak x-show="$store.sync.state === 'unauthorized'">{{ 'shopping.status.unauthorized'|trans }}</span>
        <span x-cloak x-show="$store.sync.state === 'error'">{{ 'shopping.status.error'|trans }}</span>
    </span>
{% endblock %}

{% block content %}
    <div class="shopping" x-data="shoppingList" data-shopping-app
         data-text-rejected="{{ 'shopping.toast.rejected'|trans }}"
         data-text-quantity-too-large="{{ 'shopping.quantity.too_large'|trans({'%max%': '99.999'}) }}"
         data-text-quantity-not-positive="{{ 'shopping.quantity.not_positive'|trans }}"
         data-text-quantity-invalid="{{ 'shopping.quantity.invalid'|trans }}"
         data-text-length-remaining="{{ 'shopping.length.remaining'|trans }}"
         data-text-length-over="{{ 'shopping.length.over'|trans }}"
         data-text-note-over="{{ 'shopping.length.note_over'|trans }}"
         data-text-unknown-store="{{ 'shopping.stores.unknown'|trans }}"
         data-text-valid-today="{{ 'shopping.valid.today'|trans }}"
         data-text-valid-expired="{{ 'shopping.valid.expired'|trans }}"
         data-text-valid-until="{{ 'shopping.valid.until'|trans }}"
         data-text-status="{{ {
             added: 'shopping.item_status.added'|trans,
             added_anonymous: 'shopping.item_status.added_anonymous'|trans,
             checked: 'shopping.item_status.checked'|trans,
             checked_anonymous: 'shopping.item_status.checked_anonymous'|trans,
             today: 'shopping.item_status.today'|trans,
             yesterday: 'shopping.item_status.yesterday'|trans,
             date: 'shopping.item_status.date'|trans,
             and: 'shopping.item_status.and'|trans,
         }|json_encode }}">

        <p class="notice notice--warning" x-cloak x-show="$store.sync.state === 'unauthorized'">
            {{ 'shopping.unauthorized'|trans }}
            <a href="{{ path('app_login') }}" data-turbo="false">{{ 'shopping.login'|trans }}</a>
        </p>

        <p class="shopping__loading" x-show="!ready">{{ 'shopping.loading'|trans }}</p>

        <div class="empty-state" x-cloak x-show="ready && !hasData">
            <h2 class="empty-state__headline">{{ 'shopping.first_sync.headline'|trans }}</h2>
            <p class="empty-state__text">{{ 'shopping.first_sync.text'|trans }}</p>
        </div>

        <div class="empty-state" x-cloak x-show="ready && hasData && view.openCount === 0">
            <h2 class="empty-state__headline">{{ 'shopping.empty.headline'|trans }}</h2>
            <p class="empty-state__text">{{ 'shopping.empty.text'|trans }}</p>
        </div>

        {# Laden-Filter: nur Läden, denen offene Einträge zugeordnet sind #}
        <div class="store-filter" x-cloak x-show="view.storeChips.length > 0">
            <div class="chips chips--scroll" role="group" aria-label="{{ 'shopping.stores.filter'|trans }}">
                <button type="button" class="chip" :aria-pressed="(view.storeFilter === null).toString()" @click="setStoreFilter(null)">{{ 'shopping.stores.all'|trans }}</button>
                <template x-for="chip in view.storeChips" :key="chip.id">
                    <button type="button" class="chip" :aria-pressed="(view.storeFilter === chip.id).toString()" @click="setStoreFilter(chip.id)">
                        <span x-text="chip.name"></span> <span class="chip__count" x-text="chip.count"></span>
                    </button>
                </template>
            </div>
            <p class="store-filter__hint" x-show="view.storeFilter && view.hiddenCount > 0"
               x-text="'{{ 'shopping.stores.hidden'|trans|e('js') }}'.replace('%count%', view.hiddenCount)"></p>
        </div>

        {# Offene Einträge nach Kategorie #}
        <template x-for="group in view.groups" :key="group.category.id">
            <section class="shopping-group">
                <h2 class="shopping-group__title">
                    <span class="shopping-group__icon" x-text="group.category.icon" aria-hidden="true"></span>
                    <span x-text="group.category.name"></span>
                </h2>
                <ul class="shopping-items" :data-category-id="group.category.id" x-init="enableSorting($el)">
                    <template x-for="item in group.items" :key="item.id">
                        {# Fast die ganze Zeile hakt ab (im Laden trifft man so immer), „›“ rechts öffnet den Dialog.
                           Gerade abgehakt (item.checked): bleibt an seinem Platz, bis die Liste ein paar Sekunden
                           nicht berührt wurde, siehe KEEP_IN_PLACE_MS in list.js #}
                        <li class="item-row" :class="{ 'item-row--pending': item.pending, 'item-row--checked': item.checked }" :data-id="item.id">
                            <button type="button" class="item-main" @click="check(item)" :aria-pressed="item.checked.toString()"
                                    :aria-label="(item.checked ? '{{ 'shopping.uncheck_label'|trans|e('js') }} ' : '{{ 'shopping.check_label'|trans|e('js') }} ') + item.name">
                                <span class="item-check" :class="{ 'is-checked': item.checked }"><span class="item-check__circle"></span></span>
                                <span class="item-body">
                                    <span class="item-body__name" x-text="item.name"></span>
                                    <span class="item-body__note" x-show="item.note" x-text="item.note"></span>
                                    {# Laden, direkt dahinter "gültig bis" als Etikett (heute grün, abgelaufen rot) #}
                                    <span class="item-body__meta" x-show="item.stores.length > 0 || item.validUntil">
                                        <span class="item-body__stores" x-show="item.stores.length > 0" x-text="item.stores.join(' · ')"></span>
                                        <span class="item-date" :class="'item-date--' + item.dateStatus" x-show="item.validUntil" x-text="item.validLabel"></span>
                                    </span>
                                </span>
                                <span class="item-qty" x-text="item.quantityLabel"></span>
                            </button>
                            <button type="button" class="item-edit" @click="openEditor(item)" :aria-label="'{{ 'shopping.edit_label'|trans|e('js') }} ' + item.name">›</button>
                        </li>
                    </template>
                </ul>
            </section>
        </template>

        {# Erledigt (Historie): Kreis setzt den Artikel wieder auf die Liste, Name öffnet den Dialog (wer, wann) #}
        <section class="shopping-done" x-cloak x-show="view.done.length > 0">
            <button type="button" class="shopping-done__toggle" @click="showDone = !showDone" :aria-expanded="showDone">
                <span class="shopping-done__chevron" :class="{ 'is-open': showDone }" aria-hidden="true">›</span>
                <span>{{ 'shopping.done'|trans }} (<span x-text="view.done.length"></span>)</span>
            </button>
            <p class="shopping-done__hint" x-show="showDone">{{ 'shopping.done_hint'|trans }}</p>
            <ul class="shopping-items shopping-items--done" x-show="showDone">
                <template x-for="item in view.done" :key="item.id">
                    {# Nach links wischen zeigt "Entfernen" (horizontales Scrollen mit Einrasten, ohne Gesten-JavaScript) #}
                    <li class="item-swipe">
                        <div class="item-row item-row--done item-swipe__content">
                            <button type="button" class="item-check is-checked" @click="reactivate(item)" :aria-label="'{{ 'shopping.reactivate_label'|trans|e('js') }} ' + item.name">
                                <span class="item-check__circle"></span>
                            </button>
                            <button type="button" class="item-body" @click="openEditor(item)">
                                <span class="item-body__name" x-text="item.name"></span>
                            </button>
                            <span class="item-qty" x-text="item.quantityLabel"></span>
                        </div>
                        <button type="button" class="item-swipe__action" @click="removeDone(item)" :aria-label="'{{ 'shopping.remove_label'|trans|e('js') }} ' + item.name">{{ 'shopping.remove'|trans }}</button>
                    </li>
                </template>
            </ul>
        </section>

        {# Schnelleingabe #}
        <form class="quick-add" @submit.prevent="add()" autocomplete="off">
            <p class="quick-add__hint" :class="{ 'quick-add__hint--over': lengthHint?.over }" x-cloak x-show="lengthHint" x-text="lengthHint?.text" aria-live="polite"></p>
            <ul class="quick-add__suggestions" x-cloak x-show="suggestions.length > 0">
                <template x-for="suggestion in suggestions" :key="suggestion.id">
                    <li>
                        <button type="button" class="quick-add__suggestion" @mousedown.prevent @click="pick(suggestion)">
                            <span x-text="suggestion.name"></span>
                            <span class="badge badge--muted" x-show="suggestion.store">{{ 'shopping.suggestion.store'|trans }}</span>
                            <span class="badge" x-show="suggestion.onList">{{ 'shopping.suggestion.on_list'|trans }}</span>
                            <span class="badge badge--muted" x-show="!suggestion.onList && suggestion.fromHistory">{{ 'shopping.suggestion.history'|trans }}</span>
                        </button>
                    </li>
                </template>
            </ul>
            <input class="quick-add__input" type="text" x-model="query"
                   @keydown.escape="query = ''; suggestions = []"
                   placeholder="{{ 'shopping.add_placeholder'|trans }}" aria-label="{{ 'shopping.add_placeholder'|trans }}"
                   enterkeyhint="done" autocapitalize="sentences" autocorrect="on" spellcheck="false" :disabled="!hasData">
            <button type="submit" class="quick-add__submit" :disabled="!query.trim() || lengthHint?.over === true" aria-label="{{ 'shopping.add'|trans }}">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            </button>
        </form>

        {# Hinweise (Fehler, Ablehnungen) #}
        <div class="toast" :class="{ 'toast--error': toast?.error }" x-cloak x-show="toast" x-transition.opacity role="status" aria-live="polite">
            <span class="toast__text" x-text="toast?.text"></span>
        </div>

        {# Bearbeiten-Sheet #}
        <dialog class="sheet" @close="editor = null" @click.self="closeEditor()">
            <template x-if="editor">
                <form class="sheet__form" @submit.prevent="saveEditor()">
                    <header class="sheet__header">
                        <button type="button" class="sheet__link" @click="closeEditor()">{{ 'shopping.editor.cancel'|trans }}</button>
                        <h2 class="sheet__title">{{ 'shopping.editor.title'|trans }}</h2>
                        <button type="submit" class="sheet__link sheet__link--strong">{{ 'shopping.editor.save'|trans }}</button>
                    </header>

                    <label class="field">
                        <span class="field__label">{{ 'shopping.editor.name'|trans }}</span>
                        <input class="field__input" type="text" x-model="editor.name" required maxlength="100" enterkeyhint="done">
                        <span class="field__hint" x-show="editorNameHint()" x-text="editorNameHint()"></span>
                    </label>
                    <div class="field-row">
                        <label class="field">
                            <span class="field__label">{{ 'shopping.editor.quantity'|trans }}</span>
                            <input class="field__input" type="text" inputmode="decimal" x-model="editor.quantity" @input="editor.quantityError = null" enterkeyhint="done">
                        </label>
                        <label class="field">
                            <span class="field__label">{{ 'shopping.editor.unit'|trans }}</span>
                            <select class="field__input" x-model="editor.unit">
                                <option value="">{{ 'shopping.editor.no_unit'|trans }}</option>
                                <template x-for="unit in units" :key="unit.value">
                                    <option :value="unit.value" x-text="unit.label" :selected="unit.value === editor.unit"></option>
                                </template>
                            </select>
                        </label>
                    </div>
                    <p class="form-error" x-show="editor.quantityError" x-text="editor.quantityError"></p>
                    <label class="field">
                        <span class="field__label">{{ 'shopping.editor.category'|trans }}</span>
                        <select class="field__input" x-model="editor.categoryId">
                            <template x-for="category in view.categories" :key="category.id">
                                <option :value="category.id" x-text="category.icon + ' ' + category.name" :selected="category.id === editor.categoryId"></option>
                            </template>
                        </select>
                    </label>
                    {# Läden: gewählte als Chips (antippen entfernt), darunter tippbare Auswahl #}
                    <div class="field store-picker" x-show="view.stores.length > 0">
                        <span class="field__label">{{ 'shopping.editor.stores'|trans }}</span>
                        <div class="chips" x-show="editor.storeIds.length > 0">
                            <template x-for="storeId in editor.storeIds" :key="storeId">
                                <button type="button" class="chip" aria-pressed="true" @click="toggleEditorStore(storeId)"
                                        :aria-label="'{{ 'shopping.editor.store_remove'|trans|e('js') }} ' + storeName(storeId)">
                                    <span x-text="storeName(storeId)"></span> <span aria-hidden="true">×</span>
                                </button>
                            </template>
                        </div>
                        <input class="field__input" type="text" x-model="editor.storeQuery" autocomplete="off" autocapitalize="none" spellcheck="false" enterkeyhint="done"
                               placeholder="{{ 'shopping.editor.store_add'|trans }}" aria-label="{{ 'shopping.editor.store_add'|trans }}"
                               @focus="editor.storeFocus = true" @blur="editor.storeFocus = false"
                               @keydown.enter.prevent="pickEditorStore(editorStoreOptions()[0])">
                        <ul class="store-picker__options" x-show="editor.storeFocus && editorStoreOptions().length > 0">
                            <template x-for="store in editorStoreOptions()" :key="store.id">
                                <li><button type="button" class="store-picker__option" @mousedown.prevent @click="pickEditorStore(store)" x-text="store.name"></button></li>
                            </template>
                        </ul>
                        <p class="field__hint field__hint--left" x-show="editor.storeQuery.trim() !== '' && editorStoreOptions().length === 0"
                           x-text="'{{ 'shopping.editor.store_none'|trans|e('js') }}'.replace('%name%', editor.storeQuery.trim())"></p>
                    </div>
                    <label class="field">
                        <span class="field__label">{{ 'shopping.editor.valid_until'|trans }}</span>
                        <span class="field-with-action">
                            <input class="field__input" type="date" x-model="editor.validUntil">
                            <button type="button" class="field-with-action__clear" x-show="editor.validUntil" @click="editor.validUntil = ''" aria-label="{{ 'shopping.editor.valid_until_clear'|trans }}">×</button>
                        </span>
                    </label>
                    <label class="field">
                        <span class="field__label">{{ 'shopping.editor.note'|trans }}</span>
                        <input class="field__input" type="text" x-model="editor.note" maxlength="200" enterkeyhint="done">
                    </label>

                    <p class="sheet__meta" x-show="editor.statusLines.length > 0">
                        <template x-for="line in editor.statusLines" :key="line"><span x-text="line"></span></template>
                    </p>

                    <button type="button" class="button button--primary button--block" x-show="editor.checked" @click="reactivateFromEditor()">{{ 'shopping.editor.reactivate'|trans }}</button>

                    <button type="button" class="button button--danger button--block" @click="deleteFromEditor()">{{ 'shopping.editor.delete'|trans }}</button>
                </form>
            </template>
        </dialog>
    </div>
{% endblock %}
