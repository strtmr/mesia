{% extends 'app/layout.html.twig' %}

{% block page_title %}{{ 'recipe.edit'|trans }}{% endblock %}

{% block header_actions %}
    <a class="header-link" href="{{ path('recipe_dishes_show', {id: dish.id}) }}">‹ {{ dish.name|length > 18 ? dish.name|slice(0, 17) ~ '…' : dish.name }}</a>
{% endblock %}

{% block content %}
    {{ include('recipe/_dish_form.html.twig', {submit: 'recipe.form.save'}) }}

    <form class="dish-delete" method="post" action="{{ path('recipe_dishes_delete', {id: dish.id}) }}"
          data-turbo-confirm="{{ 'recipe.delete_confirm'|trans({'%name%': dish.name}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token(delete_token) }}">
        <button type="submit" class="button button--danger button--block">{{ 'recipe.delete'|trans }}</button>
    </form>
{% endblock %}
