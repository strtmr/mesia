{% extends 'app/layout.html.twig' %}

{# Mehr → Konto → Passwort (AccountController::password) #}

{% block page_title %}{{ 'account.password.title'|trans }}{% endblock %}

{% block header_actions %}
    <a class="header-link" href="{{ path('app_more') }}">‹ {{ 'more.title'|trans }}</a>
{% endblock %}

{% block content %}
    {{ form_start(form, {attr: {class: 'form-group', novalidate: 'novalidate'}}) }}
        {# Für Passwort-Manager: zu welchem Konto das Passwort gehört #}
        <input type="text" name="username" value="{{ app.user.email }}" autocomplete="username" hidden>
        <label class="field">
            <span class="field__label">{{ 'account.password.current'|trans }}</span>
            {{ form_widget(form.currentPassword) }}
            {{ _self.errors(form.currentPassword) }}
        </label>
        <label class="field">
            <span class="field__label">{{ 'account.password.new'|trans }}</span>
            {{ form_widget(form.newPassword.first) }}
            {{ _self.errors(form.newPassword.first) }}
        </label>
        <label class="field">
            <span class="field__label">{{ 'account.password.repeat'|trans }}</span>
            {{ form_widget(form.newPassword.second) }}
        </label>
        <p class="page-hint">{{ 'account.password.hint'|trans }}</p>
        <button type="submit" class="button button--primary button--block">{{ 'account.password.save'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}

{% macro errors(field) %}
    {% for error in field.vars.errors %}
        <span class="form-error">{{ error.message }}</span>
    {% endfor %}
{% endmacro %}
